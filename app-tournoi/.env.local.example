# Copie ce fichier en .env.local et remplis les valeurs.

# Google Sheets (compte de service) — voir README.md pour la procédure complète
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxxx@xxxx.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Optionnel : Google Sheet SÉPARÉ contenant l'historique des tournois passés
# (celui qui alimente palificup.fr, onglet "Saisie"). Lu en lecture seule pour
# afficher "1er tournoi / historique" sur /ma-table. Partager ce Sheet en
# Lecteur avec la même adresse GOOGLE_SERVICE_ACCOUNT_EMAIL. Laisser vide pour
# désactiver la fonctionnalité.
HISTORY_SHEET_ID=

# Mot de passe de la page /admin
ADMIN_PASSWORD=change-moi
